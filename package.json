{
  "name": "petualangan-sejarah",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Game belajar sejarah: Peta Waktu, misi beragam, dan Kodeks.",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "content:check": "bun tools/content/validate.ts",
    "check": "bun run typecheck && bun run lint && bun run content:check && bun run assets:check && bun run test",
    "assets:build": "bun tools/assets/build.ts",
    "assets:prompt": "bun tools/assets/prompt.ts",
    "assets:check": "bun tools/assets/check.ts"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
